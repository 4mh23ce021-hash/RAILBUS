{
  "name": "railbus-platform",
  "version": "1.0.0",
  "description": "Intelligent Railway-to-City Bus Synchronization & Passenger Pooling Platform",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
