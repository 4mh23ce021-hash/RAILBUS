    "seed": "npm run seed --prefix server",
    "test": "npm run test --prefix server"
  },
  "keywords": [
    "railbus",
    "mysuru",
    "passenger-pooling",
    "ksrtc",
    "railway-bus-synchronization",
    "intelligent-mobility"
  ],
